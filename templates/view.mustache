{{!
    @template mod_nicesurvey/view

    Template for view page of nice survey course module.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * none

    Example context (json):
    {
    }
}}
{{#questionslength}}
<form id="ns-answers-form" class="form" method="POST">
    <ul class="list-group mb-3">
        {{#questions}}
            <li class="list-group-item border {{#conditionid}}d-none{{/conditionid}}"
                data-ns-question-id="{{{id}}}"
                {{#conditionid}}
                data-ns-condition-id="{{{conditionid}}}"
                data-ns-condition-value="{{{conditionvalue}}}"
                {{/conditionid}}>
                <h4 class="mb-3" title="{{#required}}{{#str}}required{{/str}}{{/required}}">
                    <span>{{{title}}}</span>
                    <small class="text-muted">({{{annotation}}})</small>
                    {{#required}}<sup style="color:red">*</sup>{{/required}}
                </h4>
                <div class="mb-3">{{{description}}}</div>
                <div class="mb-3">{{{html}}}</div>
            </li>
        {{/questions}}
    </ul>

    <div class="form-group">
        <button class="btn btn-success">{{#str}}submit{{/str}}</button>
    </div>
</form>
{{/questionslength}}